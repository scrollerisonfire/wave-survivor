{
  "name": "wave-survivor",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Wave Survivor: a fast arcade survival game built with TypeScript, PixiJS and Vite.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "format": "prettier --write .",
    "report": "node scripts/bundle-report.mjs",
    "check": "npm run lint && npm run test && npm run build && npm run report"
  },
  "dependencies": {
    "pixi.js": "^7.4.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
}
